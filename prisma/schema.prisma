datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  name           String?
  email          String?   @unique
  password       String
  role           String    @default("user")
  githubToken           String?
  githubRefreshToken   String?
  githubTokenExpiresAt DateTime?
  githubUsername        String?
  githubAvatar   String?
  projects       Project[]
  packageId      String?
  package        Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  activities     ActivityLog[]
  allocations    AppAllocation[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  app_name    String
  repo_url    String
  app_domain  String
  status      String   @default("deploying")
  arch_type   String?  @default("web_only")
  db_type     String?
  be_repo_url String?
  fe_repo_url String?
  be_domain   String?
  fe_domain   String?
  auto_cicd   Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Gói hosting: admin tạo và gán cho user. User chưa được gán dùng gói isDefault (hoặc gói dựng sẵn
// trong src/lib/packages.ts nếu chưa có gói mặc định). Admin không bị giới hạn.
// cpuMillicores / memoryMi / dbStorageGi là TỔNG tài nguyên của user, chia cho các project (AppAllocation).
model Package {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  maxProjects   Int      @default(3)
  cpuMillicores Int      @default(500)
  memoryMi      Int      @default(512)
  allowDatabase Boolean  @default(true)
  dbStorageGi   Int      @default(1)
  isDefault     Boolean  @default(false)
  users         User[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Nhật ký hoạt động hiện ở trang Activity: triển khai, xóa, redeploy, rollback, đổi gói, key AI...
// actorId khác userId khi admin thao tác trên tài khoản/app của user.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Tài nguyên user phân bổ cho từng app (chọn khi tạo project, đổi ở tab Cài đặt). Tổng các app của user
// không vượt gói. parts = số workload của app (web, backend, frontend, database) để chia đều cho từng container.
model AppAllocation {
  appName       String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cpuMillicores Int
  memoryMi      Int
  dbStorageGi   Int      @default(0)
  parts         Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@index([userId])
}
